<div class="publications">
  {% if include.show_year %}
    <h2 class="year">2026</h2>
  {% endif %}
  <ol class="bibliography">
    {% for publication in site.data.publications %}
      {% if include.selected != true or publication.selected %}
        <li>
          <div class="row">
            <div class="col col-sm-2 abbr">
              <abbr class="badge rounded w-100" style="background-color: {{ publication.color }}">
                <span>{{ publication.abbr }}</span>
              </abbr>
              <img
                class="preview z-depth-1 rounded"
                src="{{ publication.preview | prepend: '/assets/img/publication_preview/' | relative_url }}"
                alt="Preview of {{ publication.title }}"
                loading="eager"
              >
            </div>
            <div id="{{ publication.id }}" class="col-sm-10">
              <div class="title"><a href="{{ publication.arxiv }}">{{ publication.title }}</a></div>
              <div class="author">{{ publication.authors }}</div>
              <div class="periodical"><em>{{ publication.venue }}</em>, {{ publication.display_year }}. {{ publication.status }}.</div>
              <div class="links">
                <a class="abstract btn btn-sm z-depth-0" role="button">Abs</a>
                <a href="{{ publication.arxiv }}" class="btn btn-sm z-depth-0" role="button">arXiv</a>
                <a href="{{ publication.pdf }}" class="btn btn-sm z-depth-0" role="button">PDF</a>
                {% if publication.scholar %}
                  <a href="{{ publication.scholar }}" class="btn btn-sm z-depth-0" role="button">Scholar</a>
                {% endif %}
                {% if publication.code %}
                  <a href="{{ publication.code }}" class="btn btn-sm z-depth-0" role="button">Code</a>
                {% endif %}
                {% if publication.data %}
                  <a href="{{ publication.data }}" class="btn btn-sm z-depth-0" role="button">Data</a>
                {% endif %}
              </div>
              <div class="abstract hidden"><p>{{ publication.abstract }}</p></div>
            </div>
          </div>
        </li>
      {% endif %}
    {% endfor %}
  </ol>
  <p class="publication-note"><sup>*</sup> Equal contribution.</p>
</div>
